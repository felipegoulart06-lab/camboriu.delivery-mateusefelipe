SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
# Contas de demonstração na tela de login. Deixe False em produção.
DEMO_MODE=True

# Banco. Sem DATABASE_URL o projeto usa SQLite (só para desenvolvimento).
# Supabase > Project Settings > Database > Connection string > URI.
# Porta 5432 (sessão/direta) para rodar migrações; 6543 (transaction pooler) para a aplicação.
# DATABASE_URL=postgresql://postgres.qnfhfgqnvhhhkiobxpff:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
PGSSLMODE=require
CONN_MAX_AGE=600
SQLITE_PATH=

# Cache compartilhado (opcional). Necessário quando houver mais de um processo web,
# senão o bloqueio por tentativas de login conta separado em cada processo.
# REDIS_URL=redis://localhost:6379/0

# Segurança do acesso
LOGIN_ATTEMPT_LIMIT=8
LOGIN_ATTEMPT_WINDOW_SECONDS=900
MIN_PASSWORD_LENGTH=10
SESSION_COOKIE_AGE=43200
LOG_LEVEL=INFO

# Fotos do checklist antifraude. Use um volume com backup e acesso restrito.
MEDIA_ROOT=
CHECKLIST_MAX_PHOTO_MB=12

# Vercel: o disco some a cada request. Sem estas chaves o upload não persiste.
# Supabase → Project Settings → Storage → S3 access keys. Bucket privado: media.
# SUPABASE_S3_ACCESS_KEY=
# SUPABASE_S3_SECRET_KEY=
# AWS_STORAGE_BUCKET_NAME=media
# SUPABASE_PROJECT_REF=qnfhfgqnvhhhkiobxpff
# Na Vercel use a URI do pooler na porta 6543. O Django troca sozinho se VERCEL=1.

# Rastreio em tempo real. Leaflet com OpenStreetMap não exige token.
TRACKING_PING_SECONDS=15
TRACKING_STALE_SECONDS=180
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap
MAP_DEFAULT_LAT=-26.9906
MAP_DEFAULT_LNG=-48.6349

# Carga inicial da operação real (manage.py bootstrap)
PLATFORM_NAME=
PLATFORM_LEGAL_NAME=
PLATFORM_CNPJ=
PLATFORM_EMAIL=
PLATFORM_PHONE=
PLATFORM_ZIP=
PLATFORM_ADDRESS=
PLATFORM_CITY=
PLATFORM_STATE=
PLATFORM_CONTACT=
MASTER_EMAIL=
MASTER_NAME=
MASTER_PASSWORD=

# Dados de demonstração (manage.py seed_demo) — só com DEMO_MODE=True
DEMO_MASTER_EMAIL=master@camboriudelivery.local
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_VIEWER_EMAIL=viewer@demo.local
DEMO_DISPATCHER_EMAIL=central@camboriudelivery.local
DEMO_PASSWORD=Camboriu@123
