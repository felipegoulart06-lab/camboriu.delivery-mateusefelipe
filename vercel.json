{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "buildCommand": "python manage.py collectstatic --noinput",
  "functions": {
    "config/wsgi.py": {
      "maxDuration": 60
    },
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!static/).*)",
      "destination": "/api"
    }
  ]
}
